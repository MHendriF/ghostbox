name = "ghostbox"
main = "src/index.ts"
compatibility_date = "2025-10-01"

# Set workers_dev to false when using your own domain
workers_dev = false

# ---- D1 Database ----
[[d1_databases]]
binding = "DB"
database_name = "ghostbox-db"
database_id = "<YOUR_D1_DATABASE_ID>"

# ---- Email Worker ----
[email]
action = "process"

# ---- Custom domain routes ----
[[routes]]
pattern = "ghostbox.example.com"
custom_domain = true

# ---- Configurable Environment Variables ----
[vars]
APP_NAME = "GhostBox"
MAIL_DOMAIN = "example.com"
WEB_HOST = "ghostbox.example.com"
RETENTION_HOURS = "24"
MAX_INBOXES_PER_SESSION = "10"
MAX_EMAIL_SIZE_BYTES = "1048576"
MAX_BODY_SIZE_BYTES = "524288"
AUTO_REFRESH_INTERVAL_MS = "15000"
DEFAULT_MESSAGES_LIMIT = "50"
MAX_MESSAGES_LIMIT = "100"
# Master passcode protection (leave empty or unset for public mode)
AUTH_PASSCODE = "<YOUR_MASTER_PASSCODE>"

# ---- Static assets (web frontend) ----
[assets]
directory = "./src/web"

# ---- Scheduled cron triggers (retention cleanup every hour) ----
[triggers]
crons = ["0 * * * *"]

# ---- Observability ----
[observability]
enabled = true

# ---- Staging Environment ----
[env.staging]
name = "ghostbox-staging"
workers_dev = true
[env.staging.vars]
APP_NAME = "GhostBox (Staging)"
MAIL_DOMAIN = "staging.example.com"
WEB_HOST = "ghostbox-staging.example.com"
RETENTION_HOURS = "12"
MAX_INBOXES_PER_SESSION = "15"
MAX_EMAIL_SIZE_BYTES = "1048576"
MAX_BODY_SIZE_BYTES = "524288"
AUTO_REFRESH_INTERVAL_MS = "10000"
DEFAULT_MESSAGES_LIMIT = "25"
MAX_MESSAGES_LIMIT = "50"
[[env.staging.d1_databases]]
binding = "DB"
database_name = "ghostbox-staging-db"
database_id = "<YOUR_STAGING_D1_DATABASE_ID>"

# ---- Production Environment ----
[env.production]
name = "ghostbox"
workers_dev = false
[[env.production.routes]]
pattern = "ghostbox.example.com"
custom_domain = true
[env.production.vars]
APP_NAME = "GhostBox"
MAIL_DOMAIN = "example.com"
WEB_HOST = "ghostbox.example.com"
RETENTION_HOURS = "24"
MAX_INBOXES_PER_SESSION = "15"
MAX_EMAIL_SIZE_BYTES = "1048576"
MAX_BODY_SIZE_BYTES = "524288"
AUTO_REFRESH_INTERVAL_MS = "15000"
DEFAULT_MESSAGES_LIMIT = "50"
MAX_MESSAGES_LIMIT = "100"
AUTH_PASSCODE = "<YOUR_MASTER_PASSCODE>"
[[env.production.d1_databases]]
binding = "DB"
database_name = "ghostbox-db"
database_id = "<YOUR_PRODUCTION_D1_DATABASE_ID>"
